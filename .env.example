# Copy this file to .env for local use, or set these in your host's secrets settings.
# Never commit the real .env.

# Required: Gemini API key (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# Optional: if set, visitors must enter this password before using the app
APP_PASSWORD=

# Optional: 1 = save each PDF's index to ./vector_cache so it reopens instantly
# after a restart. Leave unset on a shared server: it stores the text of every
# uploaded PDF on disk.
SAVE_INDEX_TO_DISK=
